# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
BASE_URL=https://storagex.com.ng
PORT=3200
HOST_BIND=127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://storagex:CHANGE_ME@127.0.0.1:5432/storagex

# 64 hex characters (openssl rand -hex 32). Signs cookies and encrypts 2FA secrets. Changing it signs everyone out
# and invalidates every authenticator setup, so keep it safe and keep it the same.
APP_SECRET=

# Sessions: sign out after this many idle minutes, and after this many hours in any case.
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# Where nightly database backups go (pg_dump custom format).
BACKUP_DIR=/srv/storagex/data/backups

# Encrypted ID photos, selfies and consent evidence.
UPLOADS_DIR=/srv/storagex/data/uploads
ID_DOC_RETENTION_DAYS=365

# SMS (Termii). Leave empty until the account is ready; codes then cannot be sent in production.
TERMII_API_KEY=
TERMII_SENDER_ID=Kitovu
# dnd reaches Do-Not-Disturb numbers (needed for most codes); generic does not.
TERMII_CHANNEL=dnd
# Voice-call codes (Termii's Voice Call API). Change only if Termii gives you a different path.
TERMII_VOICE_PATH=/api/sms/otp/call

# SMS can go through Africa's Talking instead of Termii (voice codes still use Termii).
SMS_PROVIDER=termii
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Incoming texts (farmers texting BAL, KUDI, OWO or EGO). Point the provider to https://<site>/sms/inbound?key=<this>.
SMS_INBOUND_KEY=
# USSD gateway callback: https://<site>/ussd/at?key=<this>
USSD_KEY=

# Paystack: farmer payouts and buyer payment links. Webhook: https://<site>/hooks/paystack
PAYSTACK_SECRET_KEY=

# Identity lookups: none (default) or dojah (needs the two Dojah keys).
KYC_PROVIDER=none
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

# Live price feed, read each morning at 04:50 (format in docs/connections.md).
PRICE_FEED_URL=
PRICE_FEED_TOKEN=

# AI pre-check of identity submissions (findings for the human reviewer; it never decides).
# Photos are sent to Anthropic for this. Set KYC_AI_MODE=off to keep them on the server only.
KYC_AI_MODE=assist
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
