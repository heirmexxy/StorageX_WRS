# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
BASE_URL=https://wrs.kitovu.com.ng
PORT=3200
HOST_BIND=127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://storagex:CHANGE_ME@127.0.0.1:5432/storagex

# 64 hex characters (openssl rand -hex 32). Signs cookies and encrypts 2FA secrets. Changing it signs everyone out
# and invalidates every authenticator setup, so keep it safe and keep it the same.
APP_SECRET=

# Sessions: sign out after this many idle minutes, and after this many hours in any case.
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# Where nightly database backups go (pg_dump custom format).
BACKUP_DIR=/srv/storagex/data/backups

# Encrypted ID photos, selfies and consent evidence.
UPLOADS_DIR=/srv/storagex/data/uploads
ID_DOC_RETENTION_DAYS=365

# SMS (Termii). Leave empty until the account is ready; codes then cannot be sent in production.
TERMII_API_KEY=
TERMII_SENDER_ID=Kitovu

# Paid identity lookup provider: none (default) until a provider is chosen.
KYC_PROVIDER=none
